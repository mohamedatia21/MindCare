# MindCare Environment Variables

# MCP
# No API keys required for mcp-fetch-server (verified in Phase 4G.1)
# BRAVE_API_KEY="" # Required if using brave-search instead of fetch

# Database (Phase 8)
# DATABASE_URL="postgresql://mindcare_user:mindcare_password@localhost:5432/mindcare"
POSTGRES_MCP_DATABASE_URL="postgresql://mcp_readonly_user:password@localhost:5432/mindcare"
POSTGRES_MCP_MAX_ROWS=100
POSTGRES_MCP_QUERY_TIMEOUT_MS=5000

# Authentication (Phase 8 & Production IdP)
# JWT_SECRET="your-256-bit-secret-here"
# AUTH0_DOMAIN="your-tenant.auth0.com"
# AUTH0_CLIENT_ID="your-client-id"
# AUTH0_CLIENT_SECRET="your-client-secret"
# IDP_ISSUER="https://your-tenant.auth0.com/"
# IDP_JWKS_URI="https://your-tenant.auth0.com/.well-known/jwks.json"
# IDP_AUDIENCE="your-client-id-or-audience"

# Voice Providers
# DEEPGRAM_API_KEY=""
# OPENAI_API_KEY=""
# ELEVENLABS_API_KEY=""
# ELEVENLABS_VOICE_ID=""

# Core Services
# PORT="3000"
# LLM_API_KEY=""
# LLM_API_URL=""
# VALKEY_URL="redis://localhost:6379"
# REDIS_URL="redis://localhost:6379"
# ENABLE_LEGACY_CUTOVER_FALLBACK="false"
# CORS_ORIGIN="*"

# Security
# AUDIT_PURGE_PEPPER=""
# ENCRYPTION_MASTER_KEY=""

# Environment
# NODE_ENV="development"

KNOWLEDGE_SIMILARITY_THRESHOLD=0.65
QDRANT_URL=
QDRANT_API_KEY=

# Pinecone Vector Database
PINECONE_API_KEY=
PINECONE_INDEX_KNOWLEDGE=mindcare-knowledge
PINECONE_INDEX_MEMORY=mindcare-memories

# LangSmith Observability & Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=mindcare
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
